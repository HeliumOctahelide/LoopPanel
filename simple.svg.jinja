{%- set temperature_text %}{% if cpu.temperature is none %}--{% else %}{{ "%d"|format(cpu.temperature) }}°{{ temperature_unit }}{% endif %}{% endset -%}
{%- set load_text %}{% if cpu.load_percent is none %}--{% else %}{{ "%.0f"|format(cpu.load_percent) }}%{% endif %}{% endset -%}
<svg xmlns="http://www.w3.org/2000/svg" width="480" height="480" viewBox="0 0 480 480" xml:space="preserve">
  <!-- 配置的背景图 / GIF 铺满在下面；这层半透明底色压暗背景，保证大字可读。 -->
  <rect x="0" y="0" width="480" height="480" fill="#0e1114" fill-opacity="0.55"/>
  <line x1="40" y1="240" x2="440" y2="240" stroke="#ffffff" stroke-opacity="0.22" stroke-width="2"/>

  <!-- 投影：同样的文字向下偏移，垫在正文下面。 -->
  <g font-family="sans-serif" text-anchor="middle" font-size="170" fill="#000000" fill-opacity="0.5" stroke="#000000" stroke-opacity="0.5" stroke-width="8" stroke-linejoin="round">
    <text x="244" y="213">{{ temperature_text }}</text>
    <text x="244" y="453">{{ load_text }}</text>
  </g>

  <!-- 正文：深色描边在下、填充在上。 -->
  <g font-family="sans-serif" text-anchor="middle" stroke="#0e1114" stroke-linejoin="round" paint-order="stroke">
    <text x="240" y="52" font-size="34" letter-spacing="3" stroke-width="4" fill="#c3ccd5">CPU TEMP</text>
    <text x="240" y="206" font-size="170" stroke-width="8" fill="{% if cpu.temperature_c is none %}#9aa3ad{% elif cpu.temperature_c >= 85 %}#ff5a5a{% elif cpu.temperature_c >= 71 %}#ff8c42{% elif cpu.temperature_c >= 56 %}#f2c14e{% else %}#3ddc97{% endif %}">{{ temperature_text }}</text>

    <text x="240" y="292" font-size="34" letter-spacing="3" stroke-width="4" fill="#c3ccd5">CPU LOAD</text>
    <text x="240" y="446" font-size="170" stroke-width="8" fill="#f2f4f6">{{ load_text }}</text>
  </g>
</svg>
