<svg xmlns="http://www.w3.org/2000/svg" width="480" height="480" viewBox="0 0 480 480" xml:space="preserve">
  <rect x="0" y="0" width="480" height="105" fill="#fafaf8"/>
  <rect x="0" y="375" width="480" height="105" fill="#fafaf8"/>
  <line x1="240" y1="10" x2="240" y2="94" stroke="#deded9"/>
  <line x1="316" y1="383" x2="316" y2="470" stroke="#deded9"/>

  <g transform="translate(0 2)">
  <g fill="none" stroke-width="9">
    <circle cx="48" cy="50" r="38" stroke="#dbe8f6"/>
    <circle cx="48" cy="50" r="38" stroke="#2477d4" transform="rotate(-90 48 50)" stroke-dasharray="{{ "%.2f"|format(cpu.load_percent * 2.3876) }} 238.76"/>
    <circle cx="192" cy="50" r="38" stroke="#e5def4"/>
    <circle cx="192" cy="50" r="38" stroke="#7757c7" transform="rotate(-90 192 50)" stroke-dasharray="{{ "%.2f"|format(memory.used_percent * 2.3876) }} 238.76"/>

    <circle cx="288" cy="50" r="38" stroke="#d9eee4"/>
    {% if gpu.load_percent is not none %}<circle cx="288" cy="50" r="38" stroke="#1f9d66" transform="rotate(-90 288 50)" stroke-dasharray="{{ "%.2f"|format(gpu.load_percent * 2.3876) }} 238.76"/>{% endif %}
    <circle cx="432" cy="50" r="38" stroke="#f4e6c8"/>
    {% if gpu.memory is not none %}<circle cx="432" cy="50" r="38" stroke="#d79a2d" transform="rotate(-90 432 50)" stroke-dasharray="{{ "%.2f"|format(gpu.memory.bar_width / 230.0 * 238.76) }} 238.76"/>{% endif %}
  </g>

  <g dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" fill="#15191c">
    <text x="48" y="40" font-size="29">{{ "%.0f"|format(cpu.load_percent) }}%</text>
    <text x="48" y="65" font-size="14" letter-spacing="0.7" fill="#59636c">LOAD</text>
    <text x="192" y="36" font-size="16">{{ "%.0f"|format(memory.used_gib) }} GB</text>
    <line x1="171" y1="50" x2="213" y2="50" stroke="#59636c" stroke-width="1.5"/>
    <text x="192" y="64" font-size="16">{{ "%.0f"|format(memory.total_gib) }} GB</text>

    <text x="288" y="40" font-size="29">{% if gpu.load_percent is none %}--{% else %}{{ "%d"|format(gpu.load_percent) }}%{% endif %}</text>
    <text x="288" y="65" font-size="14" letter-spacing="0.7" fill="#59636c">LOAD</text>
    {% if gpu.memory is none %}
    <text x="432" y="50" font-size="24">--</text>
    {% else %}
    <text x="432" y="36" font-size="15">{{ "%.1f"|format(gpu.memory.used_gib) }} GB</text>
    <line x1="411" y1="50" x2="453" y2="50" stroke="#59636c" stroke-width="1.5"/>
    <text x="432" y="64" font-size="15">{{ "%.1f"|format(gpu.memory.total_gib) }} GB</text>
    {% endif %}
  </g>

  <g dominant-baseline="middle" text-anchor="middle" font-family="sans-serif">
    <text x="120" y="15" font-size="15" letter-spacing="1.1" fill="#2477d4">CPU</text>
    <text x="120" y="46" font-size="36" fill="{% if cpu.temperature_c is none %}#7f8790{% elif cpu.temperature_c >= 85 %}#d74242{% elif cpu.temperature_c >= 71 %}#e46d32{% elif cpu.temperature_c >= 56 %}#d29a26{% else %}#25a779{% endif %}">{% if cpu.temperature_c is none %}--{% else %}{{ "%d"|format(cpu.temperature_c) }}°{% endif %}</text>
    <text x="120" y="75" font-size="13" letter-spacing="0.7" fill="#59636c">TEMP</text>
    <text x="360" y="15" font-size="15" letter-spacing="1.1" fill="#1f9d66">GPU</text>
    <text x="360" y="46" font-size="36" fill="{% if gpu.temperature_c is none %}#7f8790{% elif gpu.temperature_c >= 85 %}#d74242{% elif gpu.temperature_c >= 71 %}#e46d32{% elif gpu.temperature_c >= 56 %}#d29a26{% else %}#25a779{% endif %}">{% if gpu.temperature_c is none %}--{% else %}{{ "%d"|format(gpu.temperature_c) }}°{% endif %}</text>
    <text x="360" y="75" font-size="13" letter-spacing="0.7" fill="#59636c">TEMP</text>
  </g>
  </g>

  <g dominant-baseline="hanging" font-family="sans-serif">
    <text x="10" y="383" font-size="16" letter-spacing="1.1" fill="#8a58bf">AUDIO</text>

    <text x="326" y="383" font-size="16" letter-spacing="1.1" fill="#1989b8">NETWORK</text>
    <text x="346" y="402" font-size="21" fill="#15191c">{% if io.network_down_mib_s is none %}--{% else %}{{ "%.1f"|format(io.network_down_mib_s) }}{% endif %}</text>
    <text x="422" y="402" font-size="21" fill="#15191c">{% if io.network_up_mib_s is none %}--{% else %}{{ "%.1f"|format(io.network_up_mib_s) }}{% endif %}</text>
    <text x="394" y="417" font-size="8" text-anchor="end" fill="#7f8790">MB/s</text>
    <text x="470" y="417" font-size="8" text-anchor="end" fill="#7f8790">MB/s</text>

    <text x="326" y="427" font-size="16" letter-spacing="1.1" fill="#df7438">DISK</text>
    <text x="346" y="446" font-size="21" fill="#15191c">{% if io.disk_read_mib_s is none %}--{% else %}{{ "%.0f"|format(io.disk_read_mib_s) }}{% endif %}</text>
    <text x="422" y="446" font-size="21" fill="#15191c">{% if io.disk_write_mib_s is none %}--{% else %}{{ "%.0f"|format(io.disk_write_mib_s) }}{% endif %}</text>
    <text x="394" y="461" font-size="8" text-anchor="end" fill="#7f8790">MB/s</text>
    <text x="470" y="461" font-size="8" text-anchor="end" fill="#7f8790">MB/s</text>
  </g>

  <g fill="none" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
    {% if io.network_down_mib_s is not none and io.network_down_mib_s > 0.0 %}<path d="M332 402 V415 M326 409 L332 415 L338 409" stroke="#1989b8"/>{% endif %}
    {% if io.network_up_mib_s is not none and io.network_up_mib_s > 0.0 %}<path d="M408 415 V402 M402 408 L408 402 L414 408" stroke="#2477d4"/>{% endif %}
    {% if io.disk_read_mib_s is not none and io.disk_read_mib_s > 0.0 %}<path d="M332 446 V459 M326 453 L332 459 L338 453" stroke="#df7438"/>{% endif %}
    {% if io.disk_write_mib_s is not none and io.disk_write_mib_s > 0.0 %}<path d="M408 459 V446 M402 452 L408 446 L414 452" stroke="#d74242"/>{% endif %}
  </g>

  <g id="audio-spectrum"/>
</svg>
